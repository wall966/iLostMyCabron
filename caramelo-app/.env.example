# Copier ce fichier en ".env" et remplir les valeurs (ne jamais mettre le vrai .env sur GitHub)

# Base de données MongoDB (en local ou MongoDB Atlas en ligne)
MONGO_URI="mongodb://localhost:27017/ILostMyCabron"

# Clé secrète pour signer les tokens de connexion (une longue phrase aléatoire)
JWT_SECRET=""

# Adresse Gmail + mot de passe d'application pour l'envoi des mails "mot de passe oublié"
EMAIL_USER=""
EMAIL_PASS=""

# Adresse du site (front) : lien des mails et autorisation CORS
FRONTEND_URL="http://localhost:5173"

# Identifiant client Google OAuth (le même que VITE_GOOGLE_CLIENT_ID du front)
GOOGLE_CLIENT_ID=""

# Port du serveur (fourni automatiquement par la plupart des hébergeurs)
PORT=3000
